{
  "name": "hello-interview-practice",
  "version": "1.0.0",
  "description": "Interactive examples for system design technologies",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "npm run test:redis && npm run test:postgres && npm run test:dynamodb && npm run test:elasticsearch && npm run test:kafka && npm run test:cassandra && npm run test:zookeeper && npm run test:flink",
    "test:all": "tsx scripts/test-all-examples.ts",
    "test:redis": "tsx scripts/test-redis-examples.ts",
    "test:postgres": "tsx scripts/test-postgres-examples.ts",
    "test:elasticsearch": "tsx scripts/test-elasticsearch-examples.ts",
    "test:kafka": "tsx scripts/test-kafka-examples.ts",
    "test:dynamodb": "tsx scripts/test-dynamodb-examples.ts",
    "test:cassandra": "tsx scripts/test-cassandra-examples.ts",
    "test:zookeeper": "tsx scripts/test-zookeeper-examples.ts",
    "test:flink": "tsx scripts/test-flink-examples.ts",
    "test:watch": "NON_INTERACTIVE=true tsx watch scripts/test-redis-examples.ts",
    "reset": "npm run reset:redis && npm run reset:postgres && npm run reset:dynamodb && npm run reset:elasticsearch && npm run reset:kafka && npm run reset:cassandra && npm run reset:zookeeper && npm run reset:flink",
    "reset:redis": "tsx scripts/reset-redis.ts",
    "reset:postgres": "tsx scripts/reset-postgres.ts",
    "reset:elasticsearch": "tsx scripts/reset-elasticsearch.ts",
    "reset:kafka": "tsx scripts/reset-kafka.ts",
    "reset:dynamodb": "tsx scripts/reset-dynamodb.ts",
    "reset:cassandra": "tsx scripts/reset-cassandra.ts",
    "reset:zookeeper": "tsx scripts/reset-zookeeper.ts",
    "reset:flink": "bash scripts/reset-flink.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@elastic/elasticsearch": "^8.12.0",
    "@inquirer/prompts": "^5.3.8",
    "axios": "^1.16.0",
    "cassandra-driver": "^4.9.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.5",
    "kafkajs": "^2.2.4",
    "node-zookeeper-client": "^1.1.3",
    "ora": "^8.0.1",
    "pg": "^8.12.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/node-zookeeper-client": "^1.1.0",
    "@types/pg": "^8.11.6",
    "prettier": "^3.3.2",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
