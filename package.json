{
  "name": "hello-interview-practice",
  "version": "1.0.0",
  "description": "Interactive examples for system design technologies",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "tsx scripts/test-all-examples.ts",
    "test:all": "tsx scripts/test-all-examples.ts",
    "test:redis": "tsx scripts/test-redis-examples.ts",
    "test:postgres": "tsx scripts/test-postgres-examples.ts",
    "test:kafka": "tsx scripts/test-kafka-examples.ts",
    "test:dynamodb": "tsx scripts/test-dynamodb-examples.ts",
    "test:watch": "NON_INTERACTIVE=true tsx watch scripts/test-redis-examples.ts",
    "reset": "tsx scripts/reset-all.ts",
    "reset:redis": "tsx scripts/reset-redis.ts",
    "reset:postgres": "tsx scripts/reset-postgres.ts",
    "reset:kafka": "tsx scripts/reset-kafka.ts",
    "reset:dynamodb": "tsx scripts/reset-dynamodb.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@inquirer/prompts": "^5.3.8",
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "kafkajs": "^2.2.4",
    "ora": "^8.0.1",
    "pg": "^8.12.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/pg": "^8.11.6",
    "prettier": "^3.3.2",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
